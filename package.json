{
  "name": "@leapx-ai/vibedocs",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Agent-operable VibeCoding documentation CLI with scaffold, audits, and runtime workflows.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leapx-ai/vibedocs.git"
  },
  "homepage": "https://leapx-ai.github.io/vibedocs/",
  "bugs": {
    "url": "https://github.com/leapx-ai/vibedocs/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config/index.js",
    "./reporting": "./src/reporting/index.js",
    "./rule-engine": "./src/rule-engine/index.js",
    "./schemas/runtime-report.schema.json": "./schemas/runtime-report.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "vibedocs": "./bin/vibedocs.js"
  },
  "scripts": {
    "test": "node --test",
    "vibedocs": "node ./bin/vibedocs.js",
    "pack:check": "npm pack --dry-run --cache ./.npm-cache",
    "smoke:install": "node ./scripts/smoke-install.mjs",
    "release:check": "node ./scripts/release-check.mjs"
  },
  "files": [
    "bin/",
    "guides/",
    "LICENSE",
    "scaffold/docs/",
    "schemas/runtime-report.schema.json",
    "src/",
    "templates/ACCEPTANCE-CHECKLIST.template.md",
    "templates/ANALYTICS-EVENTS.template.md",
    "templates/FEATURE-PRD.template.md",
    "templates/TECH-SPEC.template.md",
    "templates/WIREFLOW.template.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": [
    "vibecoding",
    "documentation",
    "cli",
    "markdown",
    "ssot"
  ]
}
