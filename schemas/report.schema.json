{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibedocs.dev/schemas/report.schema.json",
  "title": "VibeDocs Report",
  "type": "object",
  "required": ["schemaVersion", "tool", "run", "summary", "results"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["generatedAt", "mode", "changedPaths", "selectedPaths", "rulePacks"],
      "properties": {
        "generatedAt": { "type": "string" },
        "mode": { "type": "string" },
        "projectRoot": { "type": ["string", "null"] },
        "docsDir": { "type": ["string", "null"] },
        "configPath": { "type": ["string", "null"] },
        "changedPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selectedPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rulePacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "path"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "path": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["passed", "warned", "failed", "skipped", "bySeverity", "byCategory"],
      "properties": {
        "passed": { "type": "number" },
        "warned": { "type": "number" },
        "failed": { "type": "number" },
        "skipped": { "type": "number" },
        "bySeverity": { "type": "object" },
        "byCategory": { "type": "object" }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "status", "severity", "category", "target", "context", "reason", "evidence", "suggested_docs", "suggestion", "owner_hint", "snapshot_key"],
        "properties": {
          "rule_id": { "type": "string" },
          "status": { "type": "string" },
          "severity": { "type": "string" },
          "category": { "type": "string" },
          "target": { "type": "string" },
          "context": { "type": "string" },
          "reason": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "suggested_docs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "suggestion": { "type": "string" },
          "owner_hint": { "type": "string" },
          "snapshot_key": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
