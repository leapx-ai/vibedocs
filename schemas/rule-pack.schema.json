{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibedocs.dev/schemas/rule-pack.schema.json",
  "title": "VibeDocs Rule Pack",
  "type": "object",
  "required": ["id", "name", "rules"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "ownerHint": { "type": "string" },
          "suggestion": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
